branches = [{"id": "a", "name": "Holy Wave", "desc": "Sword emits a projectile wave on top of the melee attack.", "on_pick": {}, "per_level": {"wave_damage": ["mul", 1.12]}, "flags": {"wave": true}, "evo1": [{"id": "crusaders_march", "name": "Crusader's March", "desc": "Moving steadily builds Advance stacks (max 3), each adding a wave to your swing.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"crusaders_march": {"max_stacks": 3, "build_per_sec": 0.7, "clear_on_hurt": true}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "mirror_wave", "name": "Mirror Wave", "desc": "Waves reflect hostile projectiles back at enemies.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"mirror_wave": {"reflect_radius": 30.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}], "evo2": [{"id": "dawnbreaker", "name": "Dawnbreaker", "desc": "Every 5th swing plants the blade: 8 beams rotate for 1.5s (0.4s ring tell).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"dawnbreaker": {"every": 5, "beams": 8, "life": 1.5, "tell": 0.4, "turn_rate": 0.9, "mult": 0.6}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "pilgrims_road", "name": "Pilgrim's Road", "desc": "Moving lays radiant ground for 3s that burns enemies and gives you +15% speed while on it.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"pilgrims_road": {"life": 3.0, "spacing": 28.0, "dps_mult": 0.3, "speed_bonus": 0.15}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}]}, {"id": "b", "name": "Focused Zeal", "desc": "Concentrate energy: higher damage and faster swings.", "on_pick": {"damage": ["mul", 1.25], "cooldown": ["mul", 0.85]}, "per_level": {"damage": ["mul", 1.1], "cooldown": ["mul", 0.95]}, "flags": {}, "evo1": [{"id": "fervor", "name": "Fervor", "desc": "Hits build Fervor (max 10) for up to +35% swing speed and damage; it decays after 3s without a hit.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"fervor": {"max_stacks": 10, "bonus_cap": 0.35, "decay": 3.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "retribution", "name": "Retribution", "desc": "Damage taken charges the blade; the next swing releases a knockback nova (capped).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"retribution": {"charge_per_hp": 0.01, "charge_cap": 1.0, "radius": 90.0, "knockback": 200.0, "mult_cap": 2.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}], "evo2": [{"id": "holy_leap", "name": "Holy Leap", "desc": "Every 7s vault to the toughest enemy within 220px and slam, stunning 0.8s (bosses immune).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"holy_leap": {"cooldown": 7.0, "range": 220.0, "stun": 0.8, "radius": 70.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "bulwark_stance", "name": "Bulwark Stance", "desc": "Stand still 1s to raise a shield arc toward the nearest enemy: blocks shots, -60% damage from it.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"bulwark_stance": {"still_time": 1.0, "arc_deg": 120.0, "reduce": 0.6}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}]}]
