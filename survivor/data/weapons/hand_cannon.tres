base = {"damage": 46.0, "reload_time": 3.0, "pierce": 99, "radius": 9.0, "speed": 470.0, "range": 560.0, "shrapnel": 0, "shrapnel_damage": 0.35, "count": 1}
branches = [{"id": "a", "name": "Shrapnel", "desc": "Extra projectiles on hit.", "on_pick": {"shrapnel": ["add", 3]}, "per_level": {"shrapnel": ["add", 1]}, "flags": {}, "evo1": [{"id": "chain_shot", "name": "Chain Shot", "desc": "Fires a linked pair; the chain between the balls sweeps enemies.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"chain_shot": {"spread": 0.12, "chain_width": 6.0, "chain_mult": 0.5}}}, {"id": "broadside", "name": "Broadside", "desc": "While moving, also fires smaller balls port and starboard. Standing still fires forward only.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"broadside": {"side_balls": 2, "side_mult": 0.7, "min_speed": 30.0}}}], "evo2": [{"id": "phantom_broadside", "name": "Phantom Broadside", "desc": "Every 18s a ghost galleon sails along your heading (fog and horn tell) and rakes a wide lane.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"phantom_broadside": {"every": 18.0, "tell": 1.0, "lane_width": 140.0, "length": 700.0, "mult": 1.5}}}, {"id": "bombard", "name": "Bombard", "desc": "Becomes a mortar: shells land on the densest cluster after 0.7s (ground tell). No piercing line.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"bombard": {"delay": 0.7, "radius_mult": 1.4, "target": "densest", "blast": 64.0}}}]}, {"id": "b", "name": "Heavy Shot", "desc": "Projectile size increase.", "on_pick": {"radius": ["mul", 1.35], "damage": ["mul", 1.1]}, "per_level": {"radius": ["mul", 1.12]}, "flags": {}, "evo1": [{"id": "rebound", "name": "Rebound", "desc": "The ball swings back at max range, hitting both ways. Catch it to cut your reload.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"rebound": {"catch_radius": 18.0, "reload_refund": 1.0}}}, {"id": "kickback", "name": "Kickback", "desc": "Recoil becomes a 0.15s invulnerable backstep; the muzzle blasts a close cone.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"kickback": {"backstep": 60.0, "time": 0.15, "cone_deg": 50.0, "cone_range": 90.0, "cone_mult": 0.6}}}], "evo2": [{"id": "burning_pitch", "name": "Burning Pitch", "desc": "The ball leaves a fire trail (patches last 3s, capped count).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"burning_pitch": {"spacing": 40.0, "life": 3.0, "max_patches": 10, "dps_mult": 0.3, "radius": 26.0}}}, {"id": "primed_powder", "name": "Primed Powder", "desc": "Hits prime enemies with a 2s fuse; they explode, hurting neighbors (no chain reactions).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"primed_powder": {"fuse": 2.0, "radius": 50.0, "mult": 0.6, "generations": 1}}}]}]
level_scaling = {"damage": ["mul", 1.07]}
max_level = 8
