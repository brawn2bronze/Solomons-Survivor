[gd_resource type="Resource" script_class="WeaponDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/defs/weapon_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "katana"
display_name = "Katana"
description = "Close-range area swipe attacks."
behavior = "melee_swipe"
audio_event = "katana_slash"
base = {"damage": 16.0, "cooldown": 0.7, "radius": 72.0, "arc_deg": 150.0, "knockback": 60.0, "alternate": false}
branches = [{"id": "a", "name": "Wide Arc", "desc": "Increase radius.", "on_pick": {"radius": ["mul", 1.3]}, "per_level": {"radius": ["mul", 1.1]}, "flags": {}, "evo1": [{"id": "wayfinder", "name": "Wayfinder", "desc": "Swings aim along your movement direction; standing still targets the nearest enemy.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"wayfinder": {"aim_move": true}}}, {"id": "momentum_edge", "name": "Momentum Edge", "desc": "Moving builds up to 5 stacks of radius; they fade 0.6s after you stop.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"momentum_edge": {"max_stacks": 5, "radius_per_stack": 0.06, "fade": 0.6, "build_per_sec": 2.5}}}], "evo2": [{"id": "moonfall_whirl", "name": "Moonfall Whirl", "desc": "Every 5th swing is a 360 degree whirl with a ring tell, brief invulnerability and knockback.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"moonfall_whirl": {"every": 5, "tell": 0.4, "invuln": 0.25, "knockback": 160.0, "mult": 1.2}}}, {"id": "afterimage", "name": "Afterimage", "desc": "Each swing repeats from where you stood 0.6s later.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"afterimage": {"delay": 0.6, "mult": 0.7}}}]}, {"id": "b", "name": "Blitz Strikes", "desc": "Increase strike speed.", "on_pick": {"cooldown": ["mul", 0.8]}, "per_level": {"cooldown": ["mul", 0.9]}, "flags": {}, "evo1": [{"id": "weaving_blades", "name": "Weaving Blades", "desc": "Passing within ~30px of an enemy at speed fires a free slash (per-enemy cooldown).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"weaving_blades": {"pass_radius": 30.0, "min_speed": 60.0, "per_enemy_icd": 1.2, "mult": 0.6}}}, {"id": "unbroken_combo", "name": "Unbroken Combo", "desc": "Hits build a combo; the 6th swing is a finisher. Taking damage resets it.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"unbroken_combo": {"finisher_at": 6, "finisher_mult": 2.2, "reset_on_hurt": true}}}], "evo2": [{"id": "thousand_cuts", "name": "Thousand Cuts", "desc": "Every 8th swing locks a 1s flurry onto one enemy (elites first); you are slowed meanwhile.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"thousand_cuts": {"every": 8, "duration": 1.0, "cuts": 10, "cut_mult": 0.5, "move_mult": 0.4, "prefer": "elite"}}}, {"id": "reprisal", "name": "Reprisal", "desc": "Getting hit triggers an instant cross-slash with heavy knockback (6s cooldown).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"reprisal": {"cooldown": 6.0, "knockback": 220.0, "mult": 1.5}}}]}]
level_scaling = {"damage": ["mul", 1.07]}
max_level = 8
color = Color(0.863, 0.902, 1.000, 1)
icon = "res://art/weapons/katana.png"
icon_frames = 1
icon_fps = 8.0
preview_kind = "static"
anims = {}
caps = {"cooldown": [0.30, 99.0], "damage": [0.1, 500.0], "radius": [20.0, 130.0]}
