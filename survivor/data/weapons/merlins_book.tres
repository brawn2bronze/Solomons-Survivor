[gd_resource type="Resource" script_class="WeaponDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/defs/weapon_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "merlins_book"
display_name = "Merlin's Book"
description = "Zaps foes with a lightning bolt that chains to other enemies."
behavior = "chain_lightning"
audio_event = "lightning_bolt"
base = {"damage": 14.0, "cooldown": 1.1, "chains": 2, "chain_range": 130.0, "range": 420.0, "orb": false, "orb_chains": 3, "orb_damage": 0.5, "orb_time": 3.0}
branches = [{"id": "a", "name": "Storm Surge", "desc": "Stronger voltage and more chains.", "on_pick": {"damage": ["mul", 1.25], "chains": ["add", 2]}, "per_level": {"damage": ["mul", 1.1], "chains": ["add", 1]}, "flags": {}, "evo1": [{"id": "static_charge", "name": "Static Charge", "desc": "Moving builds static (up to +4 chains), spent on your next cast. Standing still bleeds it.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"static_charge": {"max_bonus_chains": 4, "build_per_sec": 1.0, "bleed_per_sec": 0.5}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "lightning_lance", "name": "Lightning Lance", "desc": "The bolt becomes a narrow beam through every enemy on the line to the target.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"lightning_lance": {"width": 14.0, "length": 520.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}], "evo2": [{"id": "blink_strike", "name": "Blink Strike", "desc": "Every 8s blink ~200px along your heading, leaving a lightning scar and a thunder ring on arrival.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"blink_strike": {"cooldown": 8.0, "distance": 200.0, "scar_mult": 0.6, "ring_radius": 60.0, "invuln": 0.25}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "capacitor", "name": "Capacitor", "desc": "Casts fill a meter; at full (0.4s tell) 12 bolts hit the 12 nearest enemies at once.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"capacitor": {"meter": 10, "bolts": 12, "tell": 0.4, "bolt_mult": 0.6}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}]}, {"id": "b", "name": "Ball Lightning", "desc": "Leaves an orb that chains a fixed number of foes (lower damage, stays put).", "on_pick": {}, "per_level": {"orb_damage": ["mul", 1.12]}, "flags": {"orb": true}, "evo1": [{"id": "orbit_guard", "name": "Orbit Guard", "desc": "Up to 3 orbs circle you and zap anything that comes within ~130px.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"orbit_guard": {"orbs": 3, "orbit_radius": 60.0, "zap_range": 130.0, "tick": 0.6}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "rolling_thunder", "name": "Rolling Thunder", "desc": "The orb rolls ahead along your heading for 3s, zapping what it passes.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"rolling_thunder": {"speed": 120.0, "life": 3.0, "tick": 0.4}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}], "evo2": [{"id": "singularity", "name": "Singularity", "desc": "With 3 orbs out they fuse and drift toward you for 4s, pulling enemies in, then detonate.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"singularity": {"orbs_needed": 3, "drift_time": 4.0, "pull_px": 60.0, "radius": 110.0, "detonate_mult": 3.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "faraday_cage", "name": "Faraday Cage", "desc": "Standing inside the triangle of 3 orbs you ignore hostile projectiles; crossing enemies are zapped.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"faraday_cage": {"orbs_needed": 3, "block_projectiles": true, "edge_mult": 0.4}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}]}]
level_scaling = {"damage": ["mul", 1.07]}
max_level = 8
color = Color(0.471, 0.784, 1.000, 1)
icon = "res://art/weapons/merlins_book.png"
icon_frames = 1
icon_fps = 8.0
preview_kind = "static"
anims = {}
caps = {"cooldown": [0.55, 99.0], "damage": [0.1, 500.0], "chains": [0, 6], "chain_range": [30.0, 400.0]}
