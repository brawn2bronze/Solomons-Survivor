branches = [{"id": "a", "name": "Speed Loader", "desc": "Decrease reload time.", "on_pick": {"reload_time": ["mul", 0.8]}, "per_level": {"reload_time": ["mul", 0.9]}, "flags": {}, "evo1": [{"id": "fan_fire", "name": "Fan Fire", "desc": "Fire 2 extra shots per burst.", "ops": {"shots": ["add", 2]}, "ops2": {}, "ops3": {}, "flags": {}}, {"id": "deadeye", "name": "Deadeye", "desc": "Bigger bullets, heavier hits.", "ops": {"damage": ["mul", 1.5], "radius": ["mul", 1.3]}, "ops2": {}, "ops3": {}, "flags": {}}, {"id": "quickdraw", "name": "Quickdraw", "desc": "Reload almost instantly.", "ops": {"reload_time": ["mul", 0.5]}, "ops2": {}, "ops3": {}, "flags": {}}, {"id": "ricochet", "name": "Ricochet", "desc": "Bullets pierce one extra target.", "ops": {"pierce": ["add", 1]}, "ops2": {}, "ops3": {}, "flags": {}}], "evo2": [{"id": "bullet_storm", "name": "Bullet Storm", "desc": "Fire much faster.", "ops": {"shot_interval": ["mul", 0.6]}, "ops2": {}, "ops3": {}, "flags": {}}, {"id": "executioner", "name": "Executioner", "desc": "Massive damage, slow reload.", "ops": {"damage": ["mul", 2.2], "reload_time": ["mul", 1.3]}, "ops2": {}, "ops3": {}, "flags": {}}, {"id": "armor_piercer", "name": "Armor Piercer", "desc": "Shoot through everything.", "ops": {"pierce": ["add", 3]}, "ops2": {}, "ops3": {}, "flags": {}}, {"id": "six_shooter_ultimate", "name": "Six-Shooter Ultimate", "desc": "Everything up. Damage, shots, speed.", "ops": {"damage": ["mul", 1.4], "shots": ["add", 2], "shot_interval": ["mul", 0.85]}, "ops2": {}, "ops3": {}, "flags": {}}]}, {"id": "b", "name": "Armor-Piercing Rounds", "desc": "Increase piercing.", "on_pick": {"pierce": ["add", 1]}, "per_level": {"pierce": ["add", 1]}, "flags": {}, "evo1": [{"id": "fan_fire", "name": "Fan Fire", "desc": "Fire 2 extra shots per burst.", "ops": {"shots": ["add", 2]}, "ops2": {}, "ops3": {}, "flags": {}}, {"id": "deadeye", "name": "Deadeye", "desc": "Bigger bullets, heavier hits.", "ops": {"damage": ["mul", 1.5], "radius": ["mul", 1.3]}, "ops2": {}, "ops3": {}, "flags": {}}, {"id": "quickdraw", "name": "Quickdraw", "desc": "Reload almost instantly.", "ops": {"reload_time": ["mul", 0.5]}, "ops2": {}, "ops3": {}, "flags": {}}, {"id": "ricochet", "name": "Ricochet", "desc": "Bullets pierce one extra target.", "ops": {"pierce": ["add", 1]}, "ops2": {}, "ops3": {}, "flags": {}}], "evo2": [{"id": "bullet_storm", "name": "Bullet Storm", "desc": "Fire much faster.", "ops": {"shot_interval": ["mul", 0.6]}, "ops2": {}, "ops3": {}, "flags": {}}, {"id": "executioner", "name": "Executioner", "desc": "Massive damage, slow reload.", "ops": {"damage": ["mul", 2.2], "reload_time": ["mul", 1.3]}, "ops2": {}, "ops3": {}, "flags": {}}, {"id": "armor_piercer", "name": "Armor Piercer", "desc": "Shoot through everything.", "ops": {"pierce": ["add", 3]}, "ops2": {}, "ops3": {}, "flags": {}}, {"id": "six_shooter_ultimate", "name": "Six-Shooter Ultimate", "desc": "Everything up. Damage, shots, speed.", "ops": {"damage": ["mul", 1.4], "shots": ["add", 2], "shot_interval": ["mul", 0.85]}, "ops2": {}, "ops3": {}, "flags": {}}]}]
