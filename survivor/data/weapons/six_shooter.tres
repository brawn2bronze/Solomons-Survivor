[gd_resource type="Resource" script_class="WeaponDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/defs/weapon_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "six_shooter"
display_name = "6-Shooter"
description = "Fires 6 consecutive shots, then reloads."
behavior = "revolver"
audio_event = "revolver_shot"
base = {"damage": 12.0, "shots": 6, "shot_interval": 0.11, "reload_time": 1.7, "pierce": 0, "range": 520.0, "speed": 640.0, "spread_deg": 3.0, "radius": 4.0, "count": 1}
branches = [{"id": "a", "name": "Speed Loader", "desc": "Decrease reload time.", "on_pick": {"reload_time": ["mul", 0.8]}, "per_level": {"reload_time": ["mul", 0.9]}, "flags": {}, "evo1": [{"id": "running_reload", "name": "Running Reload", "desc": "Reload charges 2.5x faster while you move, slower while standing still.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"running_reload": {"moving_rate": 2.5, "still_rate": 0.7}}}, {"id": "fan_the_hammer", "name": "Fan the Hammer", "desc": "With an enemy inside ~80px, the cylinder dumps in a point-blank fan (4s cooldown).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"fan_the_hammer": {"trigger_range": 80.0, "cooldown": 4.0, "fan_deg": 70.0}}}], "evo2": [{"id": "quickdraw", "name": "Quickdraw", "desc": "First shot after each reload is x3; take no damage during the reload and it pierces everything.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"quickdraw": {"first_mult": 3.0, "perfect_pierce": 99}}}, {"id": "showdown", "name": "Showdown", "desc": "Marks the toughest enemy in range; hits on it gain bonus damage that peaks at mid-range.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"showdown": {"bonus_max": 0.5, "peak": 0.6}}}]}, {"id": "b", "name": "Armor-Piercing Rounds", "desc": "Increase piercing.", "on_pick": {"pierce": ["add", 1]}, "per_level": {"pierce": ["add", 1]}, "flags": {}, "evo1": [{"id": "ricochet_rounds", "name": "Ricochet Rounds", "desc": "A bullet's final pierce bounces once to the nearest enemy within 140px at 60%.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"ricochet_rounds": {"bounces": 1, "range": 140.0, "mult": 0.6}}}, {"id": "long_barrel", "name": "Long Barrel", "desc": "+25% range; bullets gain damage with distance traveled (capped at +60%).", "ops": {"range": ["mul", 1.25]}, "ops2": {}, "ops3": {}, "flags": {"long_barrel": {"range_mult": 1.25, "per_100px": 0.1, "cap": 0.6}}}], "evo2": [{"id": "dead_eye", "name": "Dead-Eye", "desc": "Stand still 0.7s (crosshair tell): the next slug is x3 with unlimited pierce. Moving cancels.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"dead_eye": {"still_time": 0.7, "mult": 3.0, "pierce": 99}}}, {"id": "dead_mans_hand", "name": "Dead Man's Hand", "desc": "The 6th bullet of each cylinder is an explosive Ace (70px burst).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"dead_mans_hand": {"burst_radius": 70.0, "burst_mult": 2.5}}}]}]
level_scaling = {"damage": ["mul", 1.07]}
max_level = 8
color = Color(1.000, 0.839, 0.471, 1)
icon = "res://art/weapons/six_shooter.png"
icon_frames = 1
icon_fps = 8.0
preview_kind = "static"
anims = {}

proj_fx_sprite = "res://art/fx/bullet.png"
proj_fx_frames = 1
proj_fx_fps = 1.0
proj_fx_scale = 0.8
muzzle_fx_sprite = "res://art/fx/muzzle-flash.png"
muzzle_fx_frames = 3
muzzle_fx_fps = 9.0
muzzle_fx_scale = 0.7
muzzle_fx_life = 0.3
caps = {"cooldown": [0.60, 99.0], "damage": [0.1, 500.0], "shots": [1, 20], "reload_time": [0.9, 10.0], "pierce": [0, 4]}
