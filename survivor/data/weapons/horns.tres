[resource]
script = ExtResource("1_s")
id = "horns"
display_name = "Horns"
description = "Swipe horns left and right: high damage, limited radius."
behavior = "melee_swipe"
audio_event = "horn_swipe"
base = {"damage": 30.0, "cooldown": 0.85, "radius": 64.0, "arc_deg": 115.0, "knockback": 110.0, "alternate": true, "charge": false, "charge_interval": 6.0, "charge_damage": 2.5}
branches = [{"id": "a", "name": "Wild Gore", "desc": "Increased radius and attack speed.", "on_pick": {"radius": ["mul", 1.25], "cooldown": ["mul", 0.85]}, "per_level": {"radius": ["mul", 1.06], "cooldown": ["mul", 0.95]}, "flags": {}, "evo1": [{"id": "fling", "name": "Fling", "desc": "The last enemy hit by each swing is hurled 220px as a living projectile, damaging those it hits (once).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"fling": {"distance": 220.0, "mult": 1.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "hook_swing", "name": "Hook Swing", "desc": "Swings pull enemies at the arc edge inward, clumping the pack for the next swing.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"hook_swing": {"pull_px": 60.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}], "evo2": [{"id": "labrys_whirl", "name": "Labrys Whirl", "desc": "Every 6th swing starts a 1.2s whirl: keep moving at 70% speed, hitting all around every 0.2s.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"labrys_whirl": {"every": 6, "duration": 1.2, "move_mult": 0.7, "tick": 0.2, "mult": 0.5}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "labyrinth_walls", "name": "Labyrinth Walls", "desc": "Every 8s raise a half-ring of stone pillars ahead for 3s: they hurt, knock back and block projectiles.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"labyrinth_walls": {"cooldown": 8.0, "pillars": 5, "life": 3.0, "arc_deg": 140.0, "distance": 70.0, "mult": 0.5}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}]}, {"id": "b", "name": "Bull Rush", "desc": "Added charge attack: randomly charges at foes, impaling them on contact.", "on_pick": {}, "per_level": {"charge_damage": ["mul", 1.12]}, "flags": {"charge": true}, "evo1": [{"id": "steered_rush", "name": "Steered Rush", "desc": "The charge follows the direction you hold; with no input it targets the nearest enemy.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"steered_rush": {"steer": true}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "skewer", "name": "Skewer", "desc": "Charges carry the first non-elite enemy hit on your horns, then slam it at the end for area damage.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"skewer": {"carry": 1, "slam_radius": 60.0, "slam_mult": 2.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}], "evo2": [{"id": "ramming_speed", "name": "Ramming Speed", "desc": "Run in a straight line for 1s to trigger a 300px charge at x2 damage (4s cooldown); no random timer.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"ramming_speed": {"run_time": 1.0, "distance": 300.0, "mult": 2.0, "cooldown": 4.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "breaking_charge", "name": "Breaking Charge", "desc": "Enemies hit by a charge are Broken for 5s: +25% damage from all sources.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"breaking_charge": {"duration": 5.0, "taken": 1.25}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}]}]
level_scaling = {"damage": ["mul", 1.1]}
max_level = 8
color = Color(0.933, 0.886, 0.745, 1)
icon = "res://art/weapons/horns.png"
icon_frames = 1
icon_fps = 8.0
preview_kind = "static"
anims = {}
caps = {"cooldown": [0.6, 99.0], "radius": [0.0, 110.0], "charge_damage": [0.0, 4.0], "charge_interval": [4.0, 999.0]}
