[gd_resource type="Resource" script_class="PassiveDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/defs/passive_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "astral_projection"
display_name = "Astral Projection"
description = "Spawns a translucent astral copy that temporarily doubles projectiles."
behavior = "astral_clone"
audio_event = "lightning_bolt"
base = {"interval": 12.0, "duration": 5.0, "projectile_mult": 2.0}
branches = [{"id": "a", "name": "Deep Trance", "desc": "Longer wait between projections, more projectiles while active.", "on_pick": {"interval": ["mul", 1.5], "projectile_mult": ["set", 3.0]}, "per_level": {"projectile_mult": ["add", 0.25]}, "flags": {}, "evo1": [{"id": "astral_anchor", "name": "Astral Anchor", "desc": "The clone stays where summoned and casts on its own. Plant it, then run.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"astral_anchor": {"anchored": true}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "mirror_image", "name": "Mirror Image", "desc": "The clone mirrors your movement across your position.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"mirror_image": {"mirror": true}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}], "evo2": [{"id": "astral_swap", "name": "Astral Swap", "desc": "The projection ends with you and the clone swapping places; both spots detonate.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"astral_swap": {"ring_radius": 70.0, "ring_mult": 1.0, "invuln": 0.2}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "ethereal_walk", "name": "Ethereal Walk", "desc": "You become the projection for 4s: ghost through enemies (no contact damage), spells at half rate.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"ethereal_walk": {"duration": 4.0, "cast_rate": 0.5}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}]}, {"id": "b", "name": "Quick Mind", "desc": "Shorter intervals, fixed 1.5x projectile multiplier.", "on_pick": {"interval": ["mul", 0.55], "projectile_mult": ["set", 1.5]}, "per_level": {"interval": ["mul", 0.95]}, "flags": {}, "evo1": [{"id": "spell_echo", "name": "Spell Echo", "desc": "The clone repeats your cast 0.5s later at 70% power (replaces the projectile multiplier).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"spell_echo": {"delay": 0.5, "power": 0.7, "replaces_multiplier": true}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "flow_state", "name": "Flow State", "desc": "Kills during a projection extend it 0.3s each (capped at +4s).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"flow_state": {"per_kill": 0.3, "cap": 4.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}], "evo2": [{"id": "time_stop", "name": "Time Stop", "desc": "Every 4th projection freezes enemies for 1.5s (bosses immune).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"time_stop": {"every": 4, "freeze": 1.5}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "wild_magic", "name": "Wild Magic", "desc": "The clone casts a random spell (Frost Nova, Meteor, Gravity Pull), each with its own tell.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"wild_magic": {"pool": ["frost_nova", "meteor", "gravity_pull"], "tell": 0.5}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}]}]
level_scaling = {"duration": ["mul", 1.025]}
max_level = 8
color = Color(0.706, 0.784, 1.000, 1)
icon = "res://art/passives/astral_projection.png"
icon_frames = 1
icon_fps = 8.0
preview_kind = "static"
anims = {}
caps = {"interval": [8.0, 60.0], "duration": [2.0, 8.0], "projectile_mult": [1.0, 2.0]}
