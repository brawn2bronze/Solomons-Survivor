[gd_resource type="Resource" script_class="PassiveDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/defs/passive_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "astral_projection"
display_name = "Astral Projection"
description = "Spawns a translucent astral copy that temporarily doubles projectiles."
behavior = "astral_clone"
audio_event = "lightning_bolt"
base = {"interval": 12.0, "duration": 5.0, "projectile_mult": 2.0}
branches = [{"id": "a", "name": "Deep Trance", "desc": "Longer wait between projections, more projectiles while active.", "on_pick": {"interval": ["mul", 1.5], "projectile_mult": ["set", 3.0]}, "per_level": {"projectile_mult": ["add", 0.25]}, "flags": {}}, {"id": "b", "name": "Quick Mind", "desc": "Shorter intervals, fixed 1.5x projectile multiplier.", "on_pick": {"interval": ["mul", 0.55], "projectile_mult": ["set", 1.5]}, "per_level": {"interval": ["mul", 0.95]}, "flags": {}}]
level_scaling = {"duration": ["mul", 1.05]}
max_level = 8
color = Color(0.706, 0.784, 1.000, 1)
