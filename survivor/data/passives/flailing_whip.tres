[gd_resource type="Resource" script_class="PassiveDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/defs/passive_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "flailing_whip"
display_name = "Flailing Whip"
description = "Automatically strikes nearby enemies in melee range."
behavior = "whip"
audio_event = "whip_crack"
base = {"damage": 9.0, "interval": 1.0, "range": 88.0, "arc_deg": 110.0, "tick": 0.25}
branches = [{"id": "a", "name": "Barbed Chain", "desc": "Constant low damage to everything within range.", "on_pick": {"tick": ["set", 0.22], "damage": ["mul", 0.35]}, "per_level": {"damage": ["mul", 1.14]}, "flags": {"mode": "aura"}, "evo1": [{"id": "twirling_lasso", "name": "Twirling Lasso", "desc": "The chain becomes an orbiting ring that spins faster the faster you move.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"twirling_lasso": {"base_spin": 2.0, "spin_per_speed": 0.02, "hit_mult": 0.5}}}, {"id": "dragging_chain", "name": "Dragging Chain", "desc": "Leaves a barbed trail behind you for 2s (ground-only trap).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"dragging_chain": {"life": 2.0, "spacing": 24.0, "dps_mult": 0.4}}}], "evo2": [{"id": "roundup", "name": "Roundup", "desc": "Every 8s the lasso cinches: everything in range is pulled in and stunned 0.6s (bosses immune).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"roundup": {"every": 8.0, "pull_px": 60.0, "stun": 0.6}}}, {"id": "barbed_fence", "name": "Barbed Fence", "desc": "Every 6s drop a post; chains link the last three, damaging and slowing anything that crosses.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"barbed_fence": {"every": 6.0, "posts": 3, "link_mult": 0.5, "slow": 0.6}}}]}, {"id": "b", "name": "Cracking Lash", "desc": "Semi-frequent long, narrow high-damage lashes.", "on_pick": {"interval": ["set", 1.4], "damage": ["mul", 2.4], "range": ["mul", 1.6]}, "per_level": {"damage": ["mul", 1.16]}, "flags": {"mode": "lash"}, "evo1": [{"id": "sweet_spot", "name": "Sweet Spot", "desc": "The lash becomes a long narrow line; its last 20% crits x2.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"sweet_spot": {"length_mult": 1.6, "arc_deg": 30.0, "tip_frac": 0.2, "tip_mult": 2.0}}}, {"id": "snap_parry", "name": "Snap Parry", "desc": "The lash destroys hostile projectiles it crosses; each one shortens the next lash.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"snap_parry": {"refund": 0.15, "refund_cap": 0.5}}}], "evo2": [{"id": "fast_hands", "name": "Fast Hands", "desc": "A lash that hits 3 or more enemies instantly reloads the six-shooter.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"fast_hands": {"hits_needed": 3}}}, {"id": "wanted_poster", "name": "Wanted Poster", "desc": "Lashed elites and bosses are marked 8s: +25% damage from all sources while you stay within ~260px.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"wanted_poster": {"mark_time": 8.0, "taken": 1.25, "leash": 260.0}}}]}]
level_scaling = {"damage": ["mul", 1.07]}
max_level = 8
color = Color(0.784, 0.549, 0.314, 1)
icon = "res://art/passives/flailing_whip.png"
icon_frames = 1
icon_fps = 8.0
preview_kind = "static"
anims = {}
caps = {"damage": [0.1, 500.0], "interval": [0.5, 10.0], "range": [20.0, 400.0], "tick": [0.2, 5.0]}
