[gd_resource type="Resource" script_class="PassiveDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/defs/passive_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "flailing_whip"
display_name = "Flailing Whip"
description = "Automatically strikes nearby enemies in melee range."
behavior = "whip"
audio_event = "whip_crack"
base = {"damage": 9.0, "interval": 1.0, "range": 88.0, "arc_deg": 110.0, "tick": 0.25}
branches = [{"id": "a", "name": "Barbed Chain", "desc": "Constant low damage to everything within range.", "on_pick": {"tick": ["set", 0.22], "damage": ["mul", 0.35]}, "per_level": {"damage": ["mul", 1.14]}, "flags": {"mode": "aura"}, "evo1": [{"id": "barbed_lash", "name": "Barbed Lash", "desc": "Whip poisons on hit.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"poison": true}}, {"id": "ensnare", "name": "Ensnare", "desc": "Whip slows enemies.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"slow": true}}, {"id": "chain_reach", "name": "Chain Reach", "desc": "Much longer whip range.", "ops": {"range": ["mul", 1.5]}, "ops2": {}, "ops3": {}, "flags": {}}, {"id": "frenzy", "name": "Frenzy", "desc": "Whip strikes much faster.", "ops": {"tick": ["mul", 0.6]}, "ops2": {}, "ops3": {}, "flags": {}}], "evo2": [{"id": "whip_storm", "name": "Whip Storm", "desc": "Each strike explodes in an area.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"explode": true}}, {"id": "constrict", "name": "Constrict", "desc": "Heavy slow and heavy damage.", "ops": {"damage": ["mul", 1.5]}, "ops2": {}, "ops3": {}, "flags": {"slow": true, "damage_up": true}}, {"id": "soul_leech", "name": "Soul Leech", "desc": "Heal on every whip hit.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"lifesteal": true}}, {"id": "thundercrack", "name": "Thundercrack", "desc": "Chance to stun on hit.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"stun_chance": true}}]}, {"id": "b", "name": "Cracking Lash", "desc": "Semi-frequent high-damage pulses.", "on_pick": {"interval": ["set", 2.4], "damage": ["mul", 3.2], "range": ["mul", 1.2]}, "per_level": {"damage": ["mul", 1.16]}, "flags": {"mode": "pulse"}, "evo1": [{"id": "barbed_lash", "name": "Barbed Lash", "desc": "Whip poisons on hit.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"poison": true}}, {"id": "ensnare", "name": "Ensnare", "desc": "Whip slows enemies.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"slow": true}}, {"id": "chain_reach", "name": "Chain Reach", "desc": "Much longer whip range.", "ops": {"range": ["mul", 1.5]}, "ops2": {}, "ops3": {}, "flags": {}}, {"id": "frenzy", "name": "Frenzy", "desc": "Whip strikes much faster.", "ops": {"tick": ["mul", 0.6]}, "ops2": {}, "ops3": {}, "flags": {}}], "evo2": [{"id": "whip_storm", "name": "Whip Storm", "desc": "Each strike explodes in an area.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"explode": true}}, {"id": "constrict", "name": "Constrict", "desc": "Heavy slow and heavy damage.", "ops": {"damage": ["mul", 1.5]}, "ops2": {}, "ops3": {}, "flags": {"slow": true, "damage_up": true}}, {"id": "soul_leech", "name": "Soul Leech", "desc": "Heal on every whip hit.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"lifesteal": true}}, {"id": "thundercrack", "name": "Thundercrack", "desc": "Chance to stun on hit.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"stun_chance": true}}]}]
level_scaling = {"damage": ["mul", 1.07]}
max_level = 8
color = Color(0.784, 0.549, 0.314, 1)
icon = "res://art/passives/flailing_whip.png"
icon_frames = 1
icon_fps = 8.0
preview_kind = "static"
anims = {}
caps = {"damage": [0.1, 500.0], "interval": [0.3, 10.0], "range": [20.0, 400.0], "tick": [0.1, 5.0]}
