[gd_resource type="Resource" script_class="PassiveDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/defs/passive_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "webs"
display_name = "Webs"
description = "Leaves a web that slows enemy movement and attack rate. One at a time; breaks after catching a set number of enemies."
behavior = "web"
audio_event = "fang_bite"
base = {"interval": 8.0, "radius": 82.0, "slow": 0.5, "capacity": 12, "lifetime": 12.0}
branches = [{"id": "a", "name": "Wide Webs", "desc": "Larger webs.", "on_pick": {"radius": ["mul", 1.3]}, "per_level": {"radius": ["mul", 1.1]}, "flags": {}}, {"id": "b", "name": "Sticky Webs", "desc": "Stronger webs: stickier, more enemies before breaking.", "on_pick": {"slow": ["set", 0.32], "capacity": ["mul", 1.6]}, "per_level": {"capacity": ["mul", 1.15]}, "flags": {}}]
level_scaling = {"lifetime": ["mul", 1.05]}
max_level = 8
color = Color(0.902, 0.902, 0.941, 1)
icon = "res://art/passives/webs.png"
icon_frames = 1
icon_fps = 8.0
preview_kind = "static"
anims = {}
