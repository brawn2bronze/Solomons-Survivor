branches = [{"id": "a", "name": "Mycorrhizal Exchange", "desc": "Hyphae reach out and pull blooms in from afar. Nutrient beyond the cap becomes armor.", "on_pick": {"auto_absorb_radius": ["set", 90.0], "shield_per_overflow": ["set", 3.0], "shield_cap_pct": ["set", 0.25], "bloom_life": ["add", 3.0], "heal_per_bloom": ["add", 0.2], "mutualist": ["set", 1]}, "per_level": {"auto_absorb_radius": ["add", 10.0], "shield_per_overflow": ["add", 0.8], "heal_per_bloom": ["add", 0.05]}, "flags": {"mutualist": true}}, {"id": "b", "name": "Antibiosis", "desc": "Secrete antibiotics: a toxic aura that grows with Nutrient. Trades speed and healing for damage.", "on_pick": {"aura_radius": ["set", 70.0], "aura_dmg": ["set", 2.0], "aura_radius_per_stack": ["set", 6.0], "aura_dmg_per_stack": ["set", 0.4], "dmg_per_stack": ["set", 0.01], "speed_per_stack": ["set", -0.013], "heal_per_bloom": ["add", -0.2], "bloom_life": ["add", -2.0], "antibiotic": ["set", 1]}, "per_level": {"aura_radius": ["add", 4.0], "aura_dmg": ["add", 0.6], "aura_dmg_per_stack": ["add", 0.06]}, "flags": {"antibiotic": true}}]
level_scaling = {"bloom_chance": ["add", 0.05], "heal_per_bloom": ["add", 0.1], "dmg_per_stack": ["add", 0.002], "speed_per_stack": ["add", 0.0015], "stack_hold": ["add", 0.3]}
