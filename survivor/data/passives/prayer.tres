[resource]
script = ExtResource("1_s")
id = "prayer"
display_name = "Prayer"
description = "Flashes an illuminated aura at regular intervals."
behavior = "whip"
audio_event = "whip_crack"
base = {"damage": 7.0, "interval": 4.5, "range": 115.0, "tick": 0.3}
branches = [{"id": "a", "name": "Sanctified Ground", "desc": "Constant low damage within range.", "on_pick": {"tick": ["set", 0.25], "damage": ["mul", 0.4]}, "per_level": {"damage": ["mul", 1.14]}, "flags": {"mode": "aura"}, "evo1": [{"id": "consecration", "name": "Consecration", "desc": "Drops holy ground every 4s (5s life): you heal standing on it, enemies on it burn.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"consecration": {"every": 4.0, "life": 5.0, "radius_mult": 0.9, "heal_per_sec": 2.0, "dps_mult": 0.5}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "seraph_ring", "name": "Seraph Ring", "desc": "Three orbs orbit the aura edge, burning and knocking back whatever they touch.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"seraph_ring": {"orbs": 3, "touch_mult": 0.5, "knockback": 80.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}], "evo2": [{"id": "sanctuary", "name": "Sanctuary", "desc": "Every 20s a hallowed zone (5s) pushes enemies out and halves damage you take inside.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"sanctuary": {"cooldown": 20.0, "life": 5.0, "radius_mult": 1.5, "reduce": 0.5}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "lay_on_hands", "name": "Lay on Hands", "desc": "Below 30% HP (60s cooldown) a burst heals 40% and knocks everything back.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"lay_on_hands": {"hp_frac": 0.3, "cooldown": 60.0, "heal_pct": 0.4, "knockback": 260.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}]}, {"id": "b", "name": "Judgement Pulse", "desc": "Semi-frequent high-damage pulses.", "on_pick": {"interval": ["set", 2.6], "damage": ["mul", 3.4], "range": ["mul", 1.2]}, "per_level": {"damage": ["mul", 1.16]}, "flags": {"mode": "pulse"}, "evo1": [{"id": "tolling_bell", "name": "Tolling Bell", "desc": "The pulse becomes an expanding ring with knockback; its far edge hits x1.5.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"tolling_bell": {"ring_speed": 220.0, "edge_mult": 1.5, "knockback": 100.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "verdict_mark", "name": "Verdict Mark", "desc": "The pulse marks the 3 toughest; 1s later marked enemies within 300px take a x2 follow-up strike.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"verdict_mark": {"targets": 3, "delay": 1.0, "leash": 300.0, "mult": 2.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}], "evo2": [{"id": "final_judgement", "name": "Final Judgement", "desc": "Every 3rd pulse is screen-wide after a 1.2s sky tell (capped % damage vs elites).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"final_judgement": {"every": 3, "tell": 1.2, "mult": 3.0, "pct_elite": 0.08}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "twin_suns", "name": "Twin Suns", "desc": "The pulse comes from two suns hovering ~150px either side of you.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"twin_suns": {"suns": 2, "offset": 150.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}]}]
level_scaling = {"damage": ["mul", 1.07]}
max_level = 8
branch_milestones = []
color = Color(1.000, 0.941, 0.706, 1)
icon = "res://art/passives/prayer.png"
icon_frames = 1
icon_fps = 8.0
preview_kind = "static"
anims = {}
rarity = 0
unlock_hint = ""
caps = {"damage": [0.1, 500.0], "interval": [1.5, 30.0], "range": [20.0, 190.0], "tick": [0.1, 5.0]}
