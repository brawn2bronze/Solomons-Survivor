[gd_resource type="Resource" script_class="PassiveDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/defs/passive_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "pirate_crew"
display_name = "Pirate Crew"
description = "Summons ally pirates. While the crew fights beside you, your projectiles are multiplied by the number of allies."
behavior = "summon_allies"
audio_event = "hand_cannon"
base = {"interval": 14.0, "allies": 2, "duration": 6.0}
branches = [{"id": "a", "name": "Press Gang", "desc": "More allies spawned.", "on_pick": {"allies": ["add", 1]}, "per_level": {"allies": ["add", 1]}, "flags": {}, "evo1": [{"id": "gun_crew", "name": "Gun Crew", "desc": "Each ally fires its own small cannon every 1.5s at its own target (replaces the projectile multiplier).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"gun_crew": {"interval": 1.5, "mult": 0.5, "replaces_multiplier": true, "damage": 18.0}}}, {"id": "boarding_party", "name": "Boarding Party", "desc": "Every 4s an ally leaps onto the densest cluster for an area slam, then returns.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"boarding_party": {"every": 4.0, "leap_range": 240.0, "radius": 60.0, "mult": 1.0}}}], "evo2": [{"id": "jolly_roger", "name": "Jolly Roger", "desc": "The crew plants a banner for 8s: inside it, reload is x2 and you regenerate.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"jolly_roger": {"life": 8.0, "radius": 100.0, "reload_speed": 2.0, "regen": 2.0}}}, {"id": "x_marks_the_spot", "name": "X Marks the Spot", "desc": "Every 60s a dig spot appears ~300px away; reach it within 12s for a treasure draft.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"x_marks_the_spot": {"every": 60.0, "distance": 300.0, "window": 12.0}}}]}, {"id": "b", "name": "Sea Legs", "desc": "Allies last longer.", "on_pick": {"duration": ["mul", 1.35]}, "per_level": {"duration": ["mul", 1.15]}, "flags": {}, "evo1": [{"id": "grog_rations", "name": "Grog Rations", "desc": "The crew tosses a rum keg every 6s (one at a time): grab it for a small heal and a 5s damage buff.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"grog_rations": {"every": 6.0, "heal_pct": 0.05, "buff_time": 5.0, "buff_mult": 1.25}}}, {"id": "human_shield", "name": "Human Shield", "desc": "Crew bodies intercept hostile projectiles; each intercepted shot triggers a free return blast.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"human_shield": {"radius": 26.0, "counter_mult": 0.8, "damage": 14.0}}}], "evo2": [{"id": "man_overboard", "name": "Man Overboard", "desc": "A hit that would hurt you is absorbed by an ally, who respawns after 8s.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"man_overboard": {"respawn": 8.0}}}, {"id": "release_the_kraken", "name": "Release the Kraken", "desc": "When the crew departs, tentacles slam three nearby clusters (0.8s ground tell).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"release_the_kraken": {"slams": 3, "tell": 0.8, "radius": 55.0, "mult": 1.2}}}]}]
level_scaling = {"interval": ["mul", 0.98]}
max_level = 8
color = Color(0.863, 0.314, 0.314, 1)
icon = "res://art/passives/pirate_crew.png"
icon_frames = 1
icon_fps = 8.0
preview_kind = "static"
anims = {}
caps = {"interval": [3.0, 60.0], "allies": [1, 4], "duration": [2.0, 10.0]}
