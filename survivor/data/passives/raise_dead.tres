branches = [{"id": "a", "name": "Legion", "desc": "Increase how many raised dead you can have.", "on_pick": {"max_minions": ["add", 2]}, "per_level": {"max_minions": ["add", 1]}, "flags": {}}, {"id": "b", "name": "Undying Bond", "desc": "Increase duration and base stats of raised dead.", "on_pick": {"duration": ["mul", 1.4], "stat_mult": ["add", 0.25]}, "per_level": {"duration": ["mul", 1.1], "stat_mult": ["add", 0.12]}, "flags": {}}]
level_scaling = {"chance_base": ["add", 0.01]}
