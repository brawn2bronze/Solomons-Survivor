[gd_resource type="Resource" script_class="PassiveDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/defs/passive_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "flash_bombs"
display_name = "Flash Bombs"
description = "Stuns nearby enemies at intervals."
behavior = "stun_pulse"
audio_event = "goblin_hit"
base = {"interval": 6.0, "radius": 95.0, "stun": 1.2}
branches = [{"id": "a", "name": "Wide Flash", "desc": "Larger stun radius.", "on_pick": {"radius": ["mul", 1.3]}, "per_level": {"radius": ["mul", 1.12]}, "flags": {}}, {"id": "b", "name": "Lingering Flash", "desc": "Longer stun duration.", "on_pick": {"stun": ["mul", 1.4]}, "per_level": {"stun": ["mul", 1.12]}, "flags": {}}]
level_scaling = {"interval": ["mul", 0.95]}
max_level = 8
color = Color(1.000, 1.000, 0.784, 1)
