[gd_resource type="Resource" script_class="PassiveDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/defs/passive_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "flash_bombs"
display_name = "Flash Bombs"
description = "Stuns nearby enemies at intervals."
behavior = "stun_pulse"
audio_event = "goblin_hit"
base = {"interval": 6.0, "radius": 95.0, "stun": 1.2}
branches = [{"id": "a", "name": "Wide Flash", "desc": "Larger stun radius.", "on_pick": {"radius": ["mul", 1.3]}, "per_level": {"radius": ["mul", 1.12]}, "flags": {}, "evo1": [{"id": "smoke_veil", "name": "Smoke Veil", "desc": "Leaves a 4s smoke cloud: enemies inside are slowed 40% and deal 30% less contact damage.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"smoke_veil": {"life": 4.0, "slow": 0.6, "contact_mult": 0.7, "radius_mult": 1.0}}}, {"id": "trailing_mines", "name": "Trailing Mines", "desc": "Drops up to 4 flash mines along your path; each stuns when stepped on.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"trailing_mines": {"max_mines": 4, "spacing": 60.0, "arm": 0.3, "stun": 1.0}}}], "evo2": [{"id": "vanish", "name": "Vanish", "desc": "Each flash makes you untargetable for 0.8s; your next swing within 2s is a x2.5 ambush.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"vanish": {"untargetable": 0.8, "window": 2.0, "ambush_mult": 2.5}}}, {"id": "cascade_flash", "name": "Cascade Flash", "desc": "Stunned enemies that die emit a mini-flash (half radius, one generation only).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"cascade_flash": {"radius_mult": 0.5, "generations": 1}}}]}, {"id": "b", "name": "Lingering Flash", "desc": "Longer stun duration.", "on_pick": {"stun": ["mul", 1.4]}, "per_level": {"stun": ["mul", 1.12]}, "flags": {}, "evo1": [{"id": "killing_light", "name": "Killing Light", "desc": "The first katana hit on a stunned enemy is x2 and ends the stun. Stun is capped at 2s.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"killing_light": {"hit_mult": 2.0, "stun_cap": 2.0}}}, {"id": "panic_powder", "name": "Panic Powder", "desc": "Enemies flee for 1.5s, then return slowed 30% for 2s.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"panic_powder": {"fear": 1.5, "slow": 0.7, "slow_time": 2.0}}}], "evo2": [{"id": "kawarimi", "name": "Kawarimi", "desc": "When hit (12s cooldown) a log takes it, you blink ~120px away, and a flash stuns the area.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"kawarimi": {"cooldown": 12.0, "blink": 120.0, "stun": 1.0, "radius_mult": 0.8}}}, {"id": "five_point_palm", "name": "Five-Point Palm", "desc": "Marks the 3 toughest enemies; 4s later each bursts for 20% max HP (elites 8%, bosses 2%).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"five_point_palm": {"targets": 3, "delay": 4.0, "pct": 0.2, "pct_elite": 0.08, "pct_boss": 0.02}}}]}]
level_scaling = {"interval": ["mul", 0.975]}
max_level = 8
color = Color(1.000, 1.000, 0.784, 1)
icon = "res://art/passives/flash_bombs.png"
icon_frames = 1
icon_fps = 8.0
preview_kind = "static"
anims = {}
caps = {"interval": [3.0, 30.0], "radius": [30.0, 150.0], "stun": [0.1, 1.8]}
