[gd_resource type="Resource" script_class="PassiveDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/defs/passive_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "beasts_roar"
display_name = "Beast's Roar"
description = "Shout at intervals for temporary stat boosts and armor. If the armor breaks, you're stunned."
behavior = "roar"
audio_event = "horn_swipe"
base = {"interval": 15.0, "duration": 5.0, "armor_hp": 80.0, "break_stun": 1.5, "boost_damage": 0.2, "boost_speed": 0.1}
branches = [{"id": "a", "name": "Ironhide", "desc": "Increased armor and defense duration.", "on_pick": {"armor_hp": ["mul", 1.5], "duration": ["mul", 1.3]}, "per_level": {"armor_hp": ["mul", 1.12], "duration": ["mul", 1.06]}, "flags": {}, "evo1": [{"id": "spiked_hide", "name": "Spiked Hide", "desc": "While armored, enemies that hit you take thorns damage and are knocked back.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"spiked_hide": {"thorns_mult": 1.0, "knockback": 120.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "warcry_shockwave", "name": "Warcry Shockwave", "desc": "The roar pushes enemies 100px away and destroys hostile projectiles.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"warcry_shockwave": {"push_px": 100.0, "radius": 140.0, "destroy_projectiles": true}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}], "evo2": [{"id": "armor_burst", "name": "Armor Burst", "desc": "When the roar armor breaks you explode in a shock nova and gain 1s invulnerability instead of being stunned.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"armor_burst": {"nova_mult": 1.5, "invuln": 1.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "armored_charge", "name": "Armored Charge", "desc": "Each roar launches an armored charge toward the nearest enemy (ignores the charge cooldown).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"armored_charge": {"distance": 240.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}]}, {"id": "b", "name": "Rising Fury", "desc": "Increased base stat boosts (scales up).", "on_pick": {"boost_damage": ["add", 0.15], "boost_speed": ["add", 0.06]}, "per_level": {"boost_damage": ["add", 0.08], "boost_speed": ["add", 0.03]}, "flags": {}, "evo1": [{"id": "outnumbered", "name": "Outnumbered", "desc": "While roaring, +3% damage per enemy within 120px (capped at +30%).", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"outnumbered": {"per_enemy": 0.03, "radius": 120.0, "cap": 0.3}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "thundering_hooves", "name": "Thundering Hooves", "desc": "While roaring, every 0.5s of movement stomps a small shock ring around you.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"thundering_hooves": {"stomp_every": 0.5, "radius": 40.0, "mult": 0.4}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}], "evo2": [{"id": "bulldozer", "name": "Bulldozer", "desc": "While roaring you grow, cannot be knocked back or stunned, and shove enemies aside as you move.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"bulldozer": {"scale": 1.4, "shove_radius": 30.0}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}, {"id": "last_stand", "name": "Last Stand", "desc": "Below 30% HP the roar refreshes instantly (40s cooldown) at x1.5 strength.", "ops": {}, "ops2": {}, "ops3": {}, "flags": {"last_stand": {"hp_frac": 0.3, "cooldown": 40.0, "strength": 1.5}}, "icon": "", "icon_frames": 1, "icon_fps": 8.0}]}]
level_scaling = {"interval": ["mul", 0.96]}
max_level = 8
color = Color(0.863, 0.471, 0.235, 1)
caps = {"armor_hp": [0.0, 160.0], "duration": [0.0, 8.0], "interval": [10.0, 999.0], "boost_damage": [0.0, 0.5], "boost_speed": [0.0, 0.25]}
