class_name MenuMusicCurve
extends RefCounted
## Baked audio curves for the title screen, generated offline from audio/music/menu_music.ogg
## (the seamless-loop master of "Scripture Glitches"). 30 fps, one byte (0..255) per frame, wraps at LENGTH.
##   mood = slow loudness 0..1 (the song's build and climax)
##   low  = bass-band energy, fast attack / slow release (pulses)
##   hit  = onset impulses: peak 0.55..1.0, decays over ~12 frames (glitch bursts, lightning)
## If the song is replaced, re-bake this file; until then the menu still works but its sync drifts.

const FPS := 30.0
const FRAMES := 6479
const LENGTH := 215.9667
const MOOD_B64 := ""
const LOW_B64 := ""
const HIT_B64 := ""

static var _mood := PackedByteArray()
static var _low := PackedByteArray()
static var _hit := PackedByteArray()


static func _ensure() -> bool:
    if _mood.is_empty():
        _mood = Marshalls.base64_to_raw(MOOD_B64)
        _low = Marshalls.base64_to_raw(LOW_B64)
        _hit = Marshalls.base64_to_raw(HIT_B64)
    return _mood.size() >= FRAMES and _low.size() >= FRAMES and _hit.size() >= FRAMES


## Vector3(mood, low, hit), each 0..1, at song time t seconds (any t; wraps at LENGTH).
static func sample(t: float) -> Vector3:
    if not _ensure():
        return Vector3.ZERO
    var f: float = fposmod(t, LENGTH) * FPS
    var i: int = int(f)
    var fr: float = f - float(i)
    var a: int = i % FRAMES
    var b: int = (i + 1) % FRAMES
    return Vector3(
        lerpf(float(_mood[a]), float(_mood[b]), fr),
        lerpf(float(_low[a]), float(_low[b]), fr),
        lerpf(float(_hit[a]), float(_hit[b]), fr)
    ) / 255.0
