# Godot editor cache. Regenerated by `godot --headless --path . --import`
# and by the editor itself; never hand-edited, never part of a change set.
# NOTE: files already tracked under survivor/.godot/ stay tracked (history is
# preserved); this rule only stops NEW cache files from showing up as untracked.
survivor/.godot/

# Portable Godot engine used by tools/get_godot.ps1 + tools/check_parse.ps1.
# ~100 MB, rebuilt by the bootstrap script, never committed.
survivor/tools/.godot-bin/

# Python
__pycache__/
*.pyc
